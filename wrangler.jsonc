{
  // Must match the Worker's name in the Cloudflare dashboard exactly.
  "name": "todolist-app",
  "compatibility_date": "2025-01-01",

  // Static files only. The app talks to Supabase directly from the browser,
  // so there is no Worker code, no database binding and no server secret here.
  "assets": {
    "directory": "./public"
  }
}
